import std;

use std::collections::vec::Vec;
use std::memory::autoptr::AutoPtr;

type ExprRef = AutoPtr<Expr>;

type Expr = {
     data: ExprData;
     locus: (i64, i64);
};

type ExprData =
     ConstantInt(i64)
     | ConstantFloat(f64)
     | ConstantString {
        kind:
            NullTerminated
            | RawBytes
            | Plain
            ;
        data: string;
     }
     | ConstantBool(bool)
     | FunctionCall {
        callee: ExprRef;
        args: Vec<ExprRef>;
     }
     | BinaryOp {
       op: Add | Sub | Mul | Div;
       left: ExprRef;
       right: ExprRef;
     }
     ;
