// Vec.qu

use Std.Mem;
use Std.Ptr;
use Core;
use Std.Slice;

struct Vec[T] {
    buffer: *mut T,
    count: usize,
    capacity: usize,
}

pub fn new[T]() -> Vec[T] {
    return {
        .buffer = null,
        .count  = 0,
        .capacity = 0,
    };
}

pub fn with_initial_capacity[T](cap: usize) -> Vec[T] {
    let buffer = Mem.alloc(cap * sizeof(T));
    if buffer |> Ptr.is_null {
       "Vec::with_initial_capacity - Out of Memory" |> Core.panic;
    }
    return {
           .buffer = buffer
                   |> Mem.fill(0, cap),
           .capacity = cap,
           .count = 0,
    };
}

pub fn push[T](vec: &mut Vec[T], item: T) {
    if vec.count >= vec.capacity {
       let new_capacity = || {
           if vec.capacity == 0 { return 256; }
           return vec.capacity * 2;
       }();
       let new_buffer = Mem.alloc(new_capacity * sizeof(T));
       if new_buffer |> Ptr.is_null {
           "Vec::with_initial_capacity - Out of Memory" |> Core.panic;
       }
       Mem.copy(new_buffer, vec.buffer, vec.count);
       Mem.free(vec.buffer);
       vec.buffer = new_buffer;
       vec.capacity = new_capacity;
    }
    Mem.add(vec.buffer, vec.count)
    |> Mem.set(item);
    vec.count += 1;
}

pub fn count[T](vec: &const Vec[T]) -> usize {
    return vec.count;
}

pub fn map[T,U](vec: Vec[T], f: fn(T) -> U) -> Vec[U] {
    let mut new_vec = Self.with_initial_capacity(vec.capacity);
    let slice       = Slice.from_ptr(vec.buffer, vec.count);
    for item in slice {
        item |> f |> Self.push(&mut new_vec, _);
    }
    return new_vec;
}
