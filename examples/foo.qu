struct Person{
    name: string;
    age: i32;
}

fn print_name(p: &const Person) {
    extern fn printf(fmt: *const char, ...) -> i32;
    printf("Name: %.*s\n"
           |> as_ptr, p.name.length, p.name.ptr);
}

fn main() {
    let person := Person {
        .name = "sonnci",
        .age  = 19
    };
    person |> print_name;
}

module String;
fn into_lines(s: String) -> Iterator*String {...}

module Demo;
fn open_file_example() {
    let lines := File.open_file("README.txt")
        |> Iter.map(|p| {
            return p |> String.into_lines; });
    if lines |> Opt.is_some {
            for line in Opt.get(lines) {
                    line |> Fmt.println;
            }
    }
}

module Opt;

enum Option*T {
 Some: T;
 None: void;
};

fn get*T(opt: Option*T) -> T {
    match opt {
        .Some |val| => { return val; };
        .None => {
            "Opt.get called on invalid optional" |> Core.panic;
        },
    }
}

fn map*T*U(opt: Option*T, f: fn(T) -> U) -> Option*U {
    match opt {
        .Some |val| => { return Option.Some(f(val)); };
        .None => {
            return Option.None;
        },
    }
}

module Core;

fn panic(msg: String, loc := #call_loc) {...}
