// Std/Opt.qu

use Root.Core;

pub type Option[T] =
    Some(T)
    | None
    ;

impl[T] Option[T] {
    pub fn unwrap(move opt: Option[T]) -> T {
        if opt is {
            .Some(val) => val,
            .None => Core.panic("Opt::unwrap called on None"),
        }
    }

    pub fn unwrap_or(move opt: Option[T], default: T) -> T {
        if opt is {
            .Some(val) => val,
            .None => default,
        }
    }

    pub fn map[U](move opt: Option[T], f: fn(move T) -> U) -> Option[U] {
        if opt is {
            .Some(val) => Option.Some(f(val)),
            .None => None,
        }
    }
}
