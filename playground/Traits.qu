
// Traits carry an implicit first typpe parameter: 'This'
pub trait ToString {
    fn to_string(move this: This) -> String;
}

pub type MyType = First | Second | Third ;

impl ToString[MyType] {
    // this becomes something like
    // Qu_ModName_impl_trait_MyType_ToString_to_string
    fn to_string(move this: MyType) -> String {
        if this is {
            .First => return "first";
            .Second => return "second";
            .Third => return "third";
        }
    }
}

fn get_string[T: ToString](val: T) -> String {
    // In this context. T is guaranteed to implement ToString.
    // so the compiler uses the concrete monomorphized function.
    return val |> ToString.to_string;
}

fn print_many(args: []any ToString) {
    for arg in args {
        // Here the type of 'arg' is erased.
        // it is a Fat Pointer generated by the compiler.
        // So this uses runtime polymorphism
        let string = arg |> ToString.to_string;
        Fmt.println(string);
    }
}